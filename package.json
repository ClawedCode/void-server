{
  "name": "void-server",
  "version": "0.17.3",
  "description": "Void Server",
  "main": "server/index.js",
  "scripts": {
    "pm2": "PM2_HOME=./.pm2 ./node_modules/.bin/pm2",
    "start": "npm run pm2 -- start ecosystem.config.js",
    "stop": "npm run pm2 -- stop ecosystem.config.js",
    "restart": "npm run pm2 -- restart ecosystem.config.js",
    "logs": "npm run pm2 -- logs",
    "status": "npm run pm2 -- status",
    "kill": "npm run pm2 -- kill",
    "build": "npm run build --prefix client",
    "infra": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "plugin:add": "./scripts/plugin-add.sh",
    "plugin:remove": "./scripts/plugin-remove.sh",
    "plugin:update": "./scripts/plugin-update.sh",
    "plugin:status": "./scripts/plugin-status.sh",
    "hooks:install": "bash ./.githooks/install-hooks.sh",
    "test": "npm run test:native",
    "test:native": "cross-env TEST_ENV=native npx cucumber-js",
    "test:docker": "cross-env TEST_ENV=docker npx cucumber-js",
    "test:docker:api": "cross-env TEST_ENV=docker TEST_NO_BROWSER=true npx cucumber-js --tags \"not @ui\"",
    "test:ci": "cross-env TEST_ENV=ci npx cucumber-js --format json:tests/e2e/reports/results.json",
    "test:e2e": "cross-env TEST_ENV=native npx cucumber-js",
    "test:e2e:smoke": "cross-env TEST_ENV=native npx cucumber-js --tags @smoke",
    "test:env:start": "bash ./scripts/test-env.sh start",
    "test:env:stop": "bash ./scripts/test-env.sh stop",
    "test:env:status": "bash ./scripts/test-env.sh status",
    "test:seed": "node ./scripts/seed-test-data.js seed",
    "test:install": "npx playwright install chromium",
    "test:coverage": "bash ./scripts/test-coverage.sh",
    "test:coverage:report": "node ./scripts/coverage-remap.js && c8 report --temp-directory=coverage/v8 --include=server/** --reporter=text --reporter=html --report-dir coverage"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.0",
    "@solana/web3.js": "^1.95.0",
    "adm-zip": "^0.5.16",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "cors": "^2.8.5",
    "dockerode": "^4.0.9",
    "dotenv": "^16.3.1",
    "ed25519-hd-key": "^1.3.0",
    "ed2curve": "^0.3.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "gray-matter": "^4.0.3",
    "http-proxy-middleware": "^3.0.5",
    "neo4j-driver": "^6.0.1",
    "playwright": "^1.57.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.2",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.0.0",
    "c8": "^9.1.0",
    "cross-env": "^7.0.3",
    "pm2": "^5.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "wait-on": "^8.0.0"
  }
}
